{
  "name": "@graame/shared",
  "version": "0.0.2",
  "description": "Shared resoureces for frontend and mobile apps.",
  "main": "dist/index.js",
  "repository": "https://github.com/sansare/libstqfrontend.git",
  "author": "il.ya sald.in <saldin.iliya@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean:dist": "rm -rf dist && mkdir dist",
    "build": "yarn clean:dist && ./node_modules/.bin/babel src --presets @babel/preset-env -d dist --ignore test.js",
    "build:dev": "yarn clean:dist && ./node_modules/.bin/babel src -d dist --ignore test.js",
    "dev": "./node_modules/.bin/babel-node ./src/index.js",
    "prettier": "prettier --single-quote --trailing-comma=es5 --write './src/**'",
    "lint": "./node_modules/.bin/eslint ./src --ignore-pattern '**/*.test.js' --fix",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "eslint": "^9.38.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.2.0",
    "ramda": "^0.32.0"
  },
  "peerDependencies": {
    "ramda": "^0.32.0"
  },
  "resolutions": {
    "glob": "^11.0.3",
    "rimraf": "^6.0.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
